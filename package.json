{
  "name": "cablera-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:backend": "pnpm --filter @cablera/shared build && pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter @cablera/shared build && pnpm --filter frontend dev",
    "build": "pnpm --filter @cablera/shared build && pnpm --filter backend build && pnpm --filter frontend build",
    "prisma:migrate": "pnpm --filter backend prisma migrate dev",
    "prisma:seed": "pnpm --filter backend prisma db seed",
    "prisma:seed:clientes": "pnpm --filter backend seed:clientes",
    "prisma:studio": "pnpm --filter backend prisma studio"
  },
  "engines": {
    "node": ">=20"
  }
}
