# Variables de producción para Dokploy (pestaña "Environment" del proyecto Compose).
# NUNCA subas el archivo real con valores. Usa contraseñas largas y solo letras y números
# en POSTGRES_PASSWORD (va dentro de una URL de conexión).

POSTGRES_USER=cablera
POSTGRES_PASSWORD=
POSTGRES_DB=cablera

# Genera uno con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origen EXACTO del frontend (https, sin "/" final). Solo se admite uno.
CORS_ORIGIN=https://app.tu-dominio.com
# URL https del backend. Se incrusta al compilar el frontend y es la que usa la app Android.
VITE_API_URL=https://api.tu-dominio.com

# Solo para el primer arranque (`prisma db seed`). Obligatorias, mínimo 10 caracteres y distintas
# de "cambiar123": si faltan, el seed se niega a correr en producción.
SEED_EMPRESA_SLUG=parias
SEED_EMPRESA_NOMBRE=PARIAS
SEED_GESTOR_EMAIL=
SEED_GESTOR_PASSWORD=
SEED_GESTOR_NOMBRE=Administrador
SEED_COBRADOR_EMAIL=
SEED_COBRADOR_PASSWORD=
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
